package views

import (
    "strconv"

    "github.com/iridiumgo/iridium-icons/icon/icons"
)

// Block renders one placed block as a layout_manager_block Alpine component
// (static/layout_manager.js): it owns its span, its controls and the masonry
// row span its content needs. Edits go through the page's request queue and
// change the block in place, so an edit never re-renders the other blocks.
//
// All icon-only controls use iridium-icons so they theme with the host
// (including dark mode).
templ Block(d *PageData, b BlockData) {
    <div
        class="lm-block"
        data-lm-block
        data-id={ b.ID }
        data-cols={ strconv.Itoa(b.Cols) }
        data-remove-url={ b.RemoveURL }
        data-resize-url={ b.ResizeURL }
        data-move-url={ b.MoveURL }
        x-data="layout_manager_block"
        :data-cols="cols"
        if d.AllowReorder {
            x-sort:item={ strconv.Quote(b.ID) }
        }
    >
        <div class="lm-block-controls" x-show="editMode" x-cloak>
            <button type="button" class="lm-block-btn lm-block-btn-danger" aria-label="Remove block" title="Remove" @click="remove">
                @icons.Trash.Component()
            </button>
            if d.AllowResize {
                <button type="button" class="lm-block-btn" aria-label="Decrease size" title="Decrease size" @click="shrink">
                    @icons.Minus.Component()
                </button>
                <button type="button" class="lm-block-btn" aria-label="Increase size" title="Increase size" @click="grow">
                    @icons.Plus.Component()
                </button>
                <button type="button" class="lm-block-btn" aria-label="Toggle full width" title="Toggle full width" @click="toggleFull">
                    @icons.Maximize.Component()
                </button>
            }
            if d.AllowReorder {
                <button
                    type="button"
                    class="lm-block-btn"
                    aria-label="Move block left"
                    title="Move left"
                    @click="moveLeft"
                    disabled?={ !b.CanMoveLeft }
                    :disabled="atStart()"
                >
                    @icons.ChevronLeft.Component()
                </button>
                <button
                    type="button"
                    class="lm-block-btn"
                    aria-label="Move block right"
                    title="Move right"
                    @click="moveRight"
                    disabled?={ !b.CanMoveRight }
                    :disabled="atEnd()"
                >
                    @icons.ChevronRight.Component()
                </button>
                <span class="lm-block-handle" aria-label="Drag to reorder" title="Drag to reorder">
                    @icons.GripVertical.Component()
                </span>
            }
        </div>
        <div class="lm-block-content">
            @b.Renderer
        </div>
        if d.AllowResize {
            <button
                type="button"
                class="lm-resize-handle"
                data-lm-resize-handle
                x-show="editMode"
                x-cloak
                @pointerdown="startResize"
                aria-label="Drag to resize block"
                title="Drag to resize"
            >
                @icons.Grip.Component()
            </button>
        }
    </div>
}
