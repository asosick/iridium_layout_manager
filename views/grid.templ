package views

import (
    "encoding/json"
    "fmt"
    "strconv"
    "strings"
)

// Grid renders the block container: the swap target when the user switches
// page or resets. Edits change it in place (see layout_manager.js). The outer
// attribute set:
//
//   - data-lm-grid:        marker for the script.
//   - data-lm-shown:       the page this grid shows, which can differ from
//                          the one asked for (a page added, removed, or not
//                          in the committed layout).
//   - data-lm-names:       the pages' names as a JSON array ("" shows the
//                          number), for the page selector.
//   - data-lm-populated:   which pages hold blocks, for the page selector.
//   - data-lm-unsaved:     whether the user has a draft that differs from
//                          the committed layout shown in view mode.
//   - data-lm-columns:     the page's columns at its widest, for the
//                          settings dialog and the resize handle.
//   - data-lm-columns-at:  the page's columns at each breakpoint, xs first
//                          ("1,2,2,4,4,4"), for the settings dialog; with
//                          data-lm-columns-custom when the user chose them
//                          breakpoint by breakpoint.
//   - data-lm-spacing:     the space between blocks chosen in the settings,
//                          when one is (the stylesheet sets the gap by it).
//   - data-reorder-url:    the POST endpoint the script calls after a drag.
//   - x-sort:              Alpine sort plugin (bundled by iridium-core)
//                          drives drag-to-reorder; only blocks are items,
//                          and only their handle starts a drag.
templ Grid(d *PageData) {
    <div
        class="lm-grid"
        style={ gridStyle(d) }
        data-lm-grid
        data-lm-shown={ strconv.Itoa(d.CurrentLayout) }
        data-lm-names={ pageNamesJSON(d) }
        data-lm-populated={ populatedFlags(d) }
        data-lm-unsaved={ strconv.FormatBool(d.Unsaved) }
        data-lm-columns={ strconv.Itoa(d.GridColumns) }
        data-lm-columns-at={ joinInts(d.ColumnsAt) }
        if d.ColumnsCustom {
            data-lm-columns-custom
        }
        if d.Spacing != "" {
            data-lm-spacing={ d.Spacing }
        }
        data-reorder-url={ d.ReorderURL }
        if d.AllowReorder {
            x-sort
            x-sort:config="{ handle: '.lm-block-handle', draggable: '[data-lm-block]' }"
        }
    >
        if d.AllowResize {
            <div class="lm-grid-guide" aria-hidden="true">
                for i := 0; i < d.GridColumns; i++ {
                    <span class="lm-grid-guide-cell"></span>
                }
            </div>
        }
        <div class="lm-empty">
            <span class="lm-empty-view">No blocks yet. Click Edit to add some.</span>
            if len(d.AddOptions) > 0 {
                <span class="lm-empty-edit">
                    Nothing here yet.
                    <button type="button" class="lm-empty-add" @click="openGallery">Add a block</button>
                    or drag one in from the gallery.
                </span>
            }
        </div>
        for _, b := range d.Blocks {
            @Block(d, b)
        }
    </div>
}

// gridStyle gives the grid its columns at each breakpoint (--lm-cols-xs …
// --lm-cols-2xl, which the stylesheet picks between by the viewport's width)
// and at its widest (--lm-cols-max, which block spans count in).
func gridStyle(d *PageData) string {
    var b strings.Builder
    for i, bp := range Breakpoints {
        if i < len(d.ColumnsAt) {
            fmt.Fprintf(&b, "--lm-cols-%s:%d;", bp.Key, d.ColumnsAt[i])
        }
    }
    fmt.Fprintf(&b, "--lm-cols-max:%d", d.GridColumns)
    return b.String()
}

func joinInts(ns []int) string {
    parts := make([]string, len(ns))
    for i, n := range ns {
        parts[i] = strconv.Itoa(n)
    }
    return strings.Join(parts, ",")
}

// pageNamesJSON lists the pages' names: ["Overview","",…].
func pageNamesJSON(d *PageData) string {
    names := d.PageNames
    if names == nil {
        names = []string{}
    }
    buf, _ := json.Marshal(names)
    return string(buf)
}

// populatedFlags lists, per page, whether it holds blocks: "1,0,1".
func populatedFlags(d *PageData) string {
    flags := make([]string, len(d.LayoutContent))
    for i, has := range d.LayoutContent {
        flags[i] = "0"
        if has {
            flags[i] = "1"
        }
    }
    return strings.Join(flags, ",")
}
