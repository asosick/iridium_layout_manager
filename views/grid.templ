package views

import (
    "encoding/json"
    "fmt"
    "strconv"
    "strings"
)

// Grid renders the block container: the swap target when the user switches
// page or resets. Edits change it in place (see layout_manager.js). The outer
// attribute set:
//
//   - data-lm-grid:        marker for the script.
//   - data-lm-shown:       the page this grid shows, which can differ from
//                          the one asked for (a page added, removed, or not
//                          in the committed layout).
//   - data-lm-names:       the pages' names as a JSON array ("" shows the
//                          number), for the page selector.
//   - data-lm-populated:   which pages hold blocks, for the page selector.
//   - data-lm-unsaved:     whether the user has a draft that differs from
//                          the committed layout shown in view mode.
//   - data-reorder-url:    the POST endpoint the script calls after a drag.
//   - x-sort:              Alpine sort plugin (bundled by iridium-core)
//                          drives drag-to-reorder; only blocks are items,
//                          and only their handle starts a drag.
templ Grid(d *PageData) {
    <div
        class="lm-grid"
        style={ fmt.Sprintf("--lm-cols:%d", d.GridColumns) }
        data-lm-grid
        data-lm-shown={ strconv.Itoa(d.CurrentLayout) }
        data-lm-names={ pageNamesJSON(d) }
        data-lm-populated={ populatedFlags(d) }
        data-lm-unsaved={ strconv.FormatBool(d.Unsaved) }
        data-reorder-url={ d.ReorderURL }
        if d.AllowReorder {
            x-sort
            x-sort:config="{ handle: '.lm-block-handle', draggable: '[data-lm-block]' }"
        }
    >
        if d.AllowResize {
            <div class="lm-grid-guide" aria-hidden="true">
                for i := 0; i < d.GridColumns; i++ {
                    <span class="lm-grid-guide-cell"></span>
                }
            </div>
        }
        <div class="lm-empty">
            No blocks yet. Click Edit and pick a block to add.
        </div>
        for _, b := range d.Blocks {
            @Block(d, b)
        }
    </div>
}

// pageNamesJSON lists the pages' names: ["Overview","",…].
func pageNamesJSON(d *PageData) string {
    names := d.PageNames
    if names == nil {
        names = []string{}
    }
    buf, _ := json.Marshal(names)
    return string(buf)
}

// populatedFlags lists, per page, whether it holds blocks: "1,0,1".
func populatedFlags(d *PageData) string {
    flags := make([]string, len(d.LayoutContent))
    for i, has := range d.LayoutContent {
        flags[i] = "0"
        if has {
            flags[i] = "1"
        }
    }
    return strings.Join(flags, ",")
}
