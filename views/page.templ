package views

import (
    "fmt"
    "net/http"
    "strconv"

    "github.com/iridiumgo/iridium-icons/icon/icons"
)

// PageData carries everything the page template needs at render time.
// Constructed by LayoutManagerPage.renderPage() per request.
type PageData struct {
    GridColumns    int
    Blocks         []BlockData       // currently-placed blocks
    AddOptions     []BlockOption     // dropdown options
    ShowLockButton bool
    AllowReorder   bool
    AllowResize    bool
    ZenEnabled     bool
    // Multi-layout (multi-page) support.
    LayoutCount   int    // total customizable pages (>=1)
    CurrentLayout int    // index of the layout currently rendered
    LayoutContent []bool // per-index: does layout i hold any blocks?
    UsedLayouts   int    // count of non-empty layouts
    // ReorderURL is the per-layout reorder endpoint (carries ?layout=N) the JS
    // drag handler POSTs to.
    ReorderURL string
    // URLs are pre-resolved (panel + page prefix already applied) so the
    // template doesn't need to know about iridium's path conventions.
    URLs PageURLs
    // Request is threaded through so per-block dynamic components can read
    // it during their own Render pass.
    Request *http.Request
    Writer  http.ResponseWriter
}

// PageURLs lists the htmx endpoints the page uses. Pre-computed once per
// render so the template doesn't have to string-concat them.
type PageURLs struct {
    Add     string
    Remove  string // append ?id=...
    Resize  string // append ?id=...&delta=±1 (or ?cols=N)
    Move    string
    Reorder string
    Select  string // append ?layout=N — switch displayed layout
    Save    string
    Reset   string
    CSS     string
    JS      string
}

// BlockOption is one entry in the "Add" dropdown.
type BlockOption struct {
    Key   string
    Label string
}

// BlockData is one placed block, with its rendering Component pre-resolved.
type BlockData struct {
    ID         string
    Cols       int
    Renderer   templ.Component
    // RemoveURL etc are precomputed full URLs (including the id query).
    RemoveURL      string
    ResizeIncURL   string
    ResizeDecURL   string
    ResizeToggleURL string
    ResizeURL       string
    MoveLeftURL     string
    MoveRightURL    string
    CanMoveLeft     bool
    CanMoveRight    bool
}

// LayoutManagerComponent is the root component — the toolbar + grid. Rendered
// inside the panel chrome by iridium's CustomPanelPage.
//
// Asset order matters: the <script> is intentionally rendered BEFORE the
// x-data element, and intentionally NOT deferred. Iridium loads its own
// Alpine bundle as a type="module" script in <head>, which defers until
// DOMContentLoaded. Our body script (no defer) runs synchronously during
// parsing — before DOMContentLoaded — so it can register an alpine:init
// listener before iridium's module fires Alpine.start(). That listener then
// registers the layout_manager data component before Alpine walks the DOM,
// avoiding the "layout_manager is not defined" race we'd otherwise hit.
templ LayoutManagerComponent(d *PageData) {
    <link rel="stylesheet" href={ d.URLs.CSS }/>
    <script src={ d.URLs.JS }></script>
    <div
        class="lm-page"
        x-data="layout_manager"
        :class="editMode ? 'lm-editing' : ''"
        data-lm-select-url={ d.URLs.Select }
        data-lm-layout-count={ strconv.Itoa(d.LayoutCount) }
        data-lm-current-layout={ strconv.Itoa(d.CurrentLayout) }
        data-lm-lock-after-done={ strconv.FormatBool(d.ShowLockButton) }
        data-lm-edit-default={ strconv.FormatBool(!d.ShowLockButton) }
    >
        <template x-teleport=".ir-panel-page-actions">
            @Toolbar(d)
        </template>
        if d.ZenEnabled {
            <button
                type="button"
                class="ir-btn-outline lm-icon-btn lm-zen-exit"
                x-show="zenMode"
                x-cloak
                @click="exitZen"
            >
                @icons.Minimize.Component()
                <span>Exit Zen</span>
            </button>
        }
        @Grid(d)
    </div>
}

// Toolbar renders the heading + edit-mode controls.
//
// The controls piggy-back on iridium's existing button classes (ir-btn-primary,
// ir-btn-outline, etc.) and iridium-icons so they pick up the host theme — dark
// mode, focus rings, hover states, the lot — without us re-implementing any
// of it. Class names are the same ones iridium's own templates use.
templ Toolbar(d *PageData) {
    <div class="lm-toolbar">
        @Selectors(d, false)
        <div class="lm-controls">
            <div x-show="editMode" x-cloak class="lm-controls">
                if len(d.AddOptions) > 0 {
                    <form
                        hx-post={ d.URLs.Add }
                        hx-target="[data-lm-grid]"
                        hx-swap="outerHTML"
                        class="lm-controls"
                    >
                        // The layout the new block lands on is whatever the user
                        // is currently viewing — bound to Alpine's currentLayout.
                        <input type="hidden" name="layout" x-model="currentLayout"/>
                        <select name="type" data-lm-type-select x-model="selectedType" class="lm-select">
                            for _, opt := range d.AddOptions {
                                <option value={ opt.Key }>{ opt.Label }</option>
                            }
                        </select>
                        <button type="submit" class="ir-btn-primary lm-icon-btn">
                            @icons.Plus.Component()
                            <span>Add</span>
                        </button>
                    </form>
                }
                <form
                    hx-post={ d.URLs.Reset }
                    hx-target="[data-lm-grid]"
                    hx-swap="outerHTML"
                >
                    <input type="hidden" name="layout" x-model="currentLayout"/>
                    <button type="submit" class="ir-btn-outline lm-icon-btn" :disabled="reorderPending">
                        @icons.RotateCcw.Component()
                        <span>Reset</span>
                    </button>
                </form>
                <button
                    type="button"
                    class="ir-btn-primary lm-icon-btn"
                    hx-post={ d.URLs.Save }
                    hx-swap="none"
                    data-lm-done
                    @htmx:after-request="finishEditing($event)"
                    :disabled="reorderPending"
                >
                    @icons.Check.Component()
                    <span>Done</span>
                </button>
            </div>
            if d.ShowLockButton {
                <button type="button" class="ir-btn-outline lm-icon-btn" x-show="!editMode" @click="startEditing">
                    @icons.Lock.Component()
                    <span>Edit</span>
                </button>
            }
            if d.ZenEnabled {
                <button type="button" class="ir-btn-outline lm-icon-btn" @click="enterZen">
                    @icons.Focus.Component()
                    <span>Zen</span>
                </button>
            }
        </div>
    </div>
}

// Selectors renders the numbered page (layout) selector buttons. Behaviour
// mirrors the Filament original:
//
//   - The whole strip is hidden unless we're editing OR more than one layout
//     holds content (x-show on the group).
//   - In edit mode every numbered button shows so the user can populate empty
//     pages; in view mode only the buttons for pages that actually have content
//     appear.
//   - The active page is highlighted (ir-btn-primary), the rest are ir-btn-outline.
//   - Clicking (or pressing cmd/ctrl+N) calls selectLayout(i), which swaps the
//     grid via htmx and updates the highlight.
//
// When oob is true the strip carries hx-swap-oob so a grid mutation response
// can refresh the indicators out-of-band (keeps the "only show populated pages"
// state correct after add/remove without a full reload).
templ Selectors(d *PageData, oob bool) {
    if d.LayoutCount > 1 {
        <div
            id="lm-selectors"
            class="lm-selectors"
            x-show={ selectorGroupShow(d) }
            x-cloak
            if oob {
                hx-swap-oob="true"
            }
        >
            for i := 0; i < d.LayoutCount; i++ {
                <button
                    type="button"
                    x-show={ layoutBtnShow(d, i) }
                    :class={ layoutBtnClass(i) }
                    class="lm-layout-btn"
                    @click={ fmt.Sprintf("selectLayout(%d)", i) }
                >
                    { strconv.Itoa(i + 1) }
                </button>
            }
        </div>
    }
}

// GridResponse is the htmx response body for a grid mutation: the freshly
// rendered grid (the primary swap target) plus an out-of-band refresh of the
// page-selector strip so its "populated pages" indicators stay accurate.
templ GridResponse(d *PageData) {
    @Grid(d)
    @Selectors(d, true)
}

// selectorGroupShow returns the Alpine x-show expression for the whole selector
// strip: always while editing, otherwise only when more than one page is used.
func selectorGroupShow(d *PageData) string {
    return fmt.Sprintf("editMode || %t", d.UsedLayouts > 1)
}

// layoutBtnShow returns the x-show expression for a single page button. Pages
// with content are visible in both modes; empty pages only while editing.
func layoutBtnShow(d *PageData, i int) string {
    if i >= 0 && i < len(d.LayoutContent) && d.LayoutContent[i] {
        return "true"
    }
    return "editMode"
}

// layoutBtnClass returns the :class expression toggling the active page's
// highlight against Alpine's currentLayout state.
func layoutBtnClass(i int) string {
    return fmt.Sprintf("currentLayout === %d ? 'ir-btn-primary' : 'ir-btn-outline'", i)
}

// gridStyleVar returns an inline style declaration setting the --lm-cols var
// the CSS reads. We use a CSS variable rather than a raw grid-template-
// columns value so the rest of the styling stays in the stylesheet.
func gridStyleVar(cols int) string {
    return fmt.Sprintf("--lm-cols:%d", cols)
}
