package views

import (
    "net/http"
    "strconv"

    "github.com/iridiumgo/iridium-icons/icon/icons"
)

// PageData carries everything the page template needs at render time.
// Constructed by LayoutManagerPage.GetComponent() per request.
type PageData struct {
    GridColumns    int               // the shown page's columns
    Blocks         []BlockData       // currently-placed blocks
    AddOptions     []BlockOption     // the block gallery's cards
    ShowLockButton bool
    AllowReorder   bool
    AllowResize    bool
    ZenEnabled     bool
    // Settings: edit mode has a Settings button, which opens the settings
    // dialog. MaxColumns is the most columns it offers.
    Settings   bool
    MaxColumns int
    // Spacing is the space between the shown page's blocks chosen in the
    // settings ("normal", "compact", "tight", "none"); "" follows the page's
    // vertical padding.
    Spacing string
    // ToolbarRight puts the toolbar at the right of a header with no title.
    ToolbarRight bool
    // Multi-layout (multi-page) support.
    LayoutCount   int      // pages in the layout state shown (>=1)
    CurrentLayout int      // index of the layout currently rendered
    LayoutContent []bool   // per-index: does layout i hold any blocks?
    PageNames     []string // per-index: the page's name, "" shows its number
    UsedLayouts   int      // count of non-empty layouts
    // AddablePages: the user adds and removes pages (no fixed LayoutCount).
    AddablePages bool
    // RenamablePages: the user can name pages.
    RenamablePages bool
    // Unsaved reports a draft that differs from the committed layout, which
    // view mode shows: entering edit mode then loads the draft.
    Unsaved bool
    // ReorderURL is the per-layout reorder endpoint (carries ?layout=N) the JS
    // drag handler POSTs to.
    ReorderURL string
    // URLs are pre-resolved (panel + page prefix already applied) so the
    // template doesn't need to know about iridium's path conventions.
    URLs PageURLs
    // Request is threaded through so per-block dynamic components can read
    // it during their own Render pass.
    Request *http.Request
    Writer  http.ResponseWriter
}

// PageURLs lists the htmx endpoints the page uses. Pre-computed once per
// render so the template doesn't have to string-concat them.
type PageURLs struct {
    Add     string // append ?type=...&layout=N, and &at=I to insert
    Preview string // append ?type=... — one block type, for the gallery
    Remove  string // append ?id=...
    Resize  string // append ?id=...&delta=±1 (or ?cols=N)
    Move    string
    Reorder string
    Select  string // append ?layout=N — switch displayed layout
    Save    string
    Reset   string
    // Pages: add one, remove ?layout=N, rename ?layout=N (form name=…).
    AddPage    string
    RemovePage string
    RenamePage string
    // Settings: ?layout=N&columns=N&spacing=… → the page's grid.
    Settings string
}

// SpacingOption is one choice of spacing in the settings dialog.
type SpacingOption struct {
    Value string
    Label string
}

// SpacingOptions are the settings dialog's spacings, widest first.
var SpacingOptions = []SpacingOption{
    {Value: "normal", Label: "Normal"},
    {Value: "compact", Label: "Compact"},
    {Value: "tight", Label: "Tight"},
    {Value: "none", Label: "None"},
}

// PageNameLength is the longest page name the server keeps, in characters.
const PageNameLength = 40

// BlockOption is one card in the block gallery.
type BlockOption struct {
    Key        string
    Label      string
    PreviewURL string // renders the block for the card's preview
}

// BlockData is one placed block, with its rendering Component pre-resolved.
type BlockData struct {
    ID       string
    Cols     int
    Renderer templ.Component
    // The block's endpoints, with its id and layout in the query: resize
    // takes &cols=N or &delta=±1, move &delta=±1.
    RemoveURL    string
    ResizeURL    string
    MoveURL      string
    CanMoveLeft  bool
    CanMoveRight bool
}

// LayoutManagerContent renders the grid inside Iridium's native custom-page
// content slot. The page shell owns the Alpine controller and renders Toolbar
// directly in its header action area.
//
// The Exit Zen button is teleported to <body>: the panel's sticky top bar
// stacks above everything in the page content, fixed elements included.
templ LayoutManagerContent(d *PageData) {
    if d.ZenEnabled {
        <template x-teleport="body">
            <button
                type="button"
                class="ir-btn-outline lm-icon-btn lm-zen-exit"
                x-show="zenMode"
                x-cloak
                @click="exitZen"
            >
                @icons.Minimize.Component()
                <span>Exit Zen</span>
            </button>
        </template>
    }
    // The wrapper is the container the grid's responsive columns query.
    <div class="lm-grid-wrap">
        @Grid(d)
    </div>
    if len(d.AddOptions) > 0 {
        @Gallery(d)
    }
    if d.Settings {
        @SettingsDialog(d)
    }
}

// SettingsDialog is the page settings: how many columns the page shown has
// and how much space it leaves between its blocks. It is a modal <dialog>
// laid out as Iridium's own modals are. Apply sends the choice to the
// server, through the page's queue, as an edit like any other.
//
// The dialog element fills the window, so a click beside its panel lands on
// the dialog itself and closes it.
templ SettingsDialog(d *PageData) {
    <dialog
        class="lm-settings"
        data-lm-settings
        aria-labelledby="lm-settings-title"
        aria-describedby="lm-settings-description"
        @close="settingsClosed"
        @click.self="closeSettings"
    >
        <form class="ir-modal-dialog lm-settings-panel" @submit.prevent="applySettings">
            <button type="button" class="ir-modal-close-btn" aria-label="Close" @click="closeSettings">
                @icons.X.Component()
            </button>
            <div class="ir-modal-content">
                <div class="ir-modal-header">
                    <h2 id="lm-settings-title" class="ir-modal-title">Page settings</h2>
                    <p id="lm-settings-description" class="ir-modal-description" x-text="settingsDescription()"></p>
                </div>
                <fieldset class="lm-settings-field">
                    <legend class="ir-field-label">Columns</legend>
                    <div class="lm-segmented">
                        for n := 1; n <= d.MaxColumns; n++ {
                            <label class="lm-segment">
                                <input type="radio" name="lm-columns" value={ strconv.Itoa(n) } x-model="settingsColumns"/>
                                <span>{ strconv.Itoa(n) }</span>
                            </label>
                        }
                    </div>
                    <p class="lm-settings-hint">Blocks keep their width; full-width blocks stay full width.</p>
                </fieldset>
                <fieldset class="lm-settings-field">
                    <legend class="ir-field-label">Space between blocks</legend>
                    <div class="lm-segmented">
                        for _, s := range SpacingOptions {
                            <label class="lm-segment">
                                <input type="radio" name="lm-spacing" value={ s.Value } x-model="settingsSpacing"/>
                                <span class="lm-spacing-glyph" data-spacing={ s.Value } aria-hidden="true"><i></i><i></i><i></i></span>
                                <span>{ s.Label }</span>
                            </label>
                        }
                    </div>
                </fieldset>
                <div class="ir-modal-footer">
                    <button type="button" class="ir-btn-outline" @click="closeSettings">Cancel</button>
                    <button type="submit" class="ir-btn-primary" data-lm-settings-apply :disabled="!settingsChanged()">Apply</button>
                </div>
            </div>
        </form>
    </dialog>
}

// PageAttributes binds layout-manager state to Iridium's native page root.
func PageAttributes(d *PageData) templ.Attributes {
    attrs := templ.Attributes{
        "data-lm-page":            "true",
        "x-data":                  "layout_manager",
        ":class":                  "rootClass()",
        "data-lm-select-url":      d.URLs.Select,
        "data-lm-add-url":         d.URLs.Add,
        "data-lm-save-url":        d.URLs.Save,
        "data-lm-reset-url":       d.URLs.Reset,
        "data-lm-add-page-url":    d.URLs.AddPage,
        "data-lm-remove-page-url": d.URLs.RemovePage,
        "data-lm-rename-page-url": d.URLs.RenamePage,
        "data-lm-addable-pages":   strconv.FormatBool(d.AddablePages),
        "data-lm-renamable-pages": strconv.FormatBool(d.RenamablePages),
        "data-lm-layout-count":    strconv.Itoa(d.LayoutCount),
        "data-lm-current-layout":  strconv.Itoa(d.CurrentLayout),
        "data-lm-lock-after-done": strconv.FormatBool(d.ShowLockButton),
        "data-lm-edit-default":    strconv.FormatBool(!d.ShowLockButton),
    }
    if d.Settings {
        attrs["data-lm-settings-url"] = d.URLs.Settings
    }
    if d.ToolbarRight {
        attrs["data-lm-toolbar-align"] = "right"
    }
    return attrs
}

// HeaderAttributes keeps Zen mode inside the same Alpine-owned page shell.
func HeaderAttributes(d *PageData) templ.Attributes {
    if !d.ZenEnabled {
        return nil
    }
    return templ.Attributes{"x-show": "!zenMode"}
}

// Toolbar renders the layout controls in Iridium's native page header.
//
// The controls piggy-back on iridium's existing button classes (ir-btn-primary,
// ir-btn-outline, etc.) and iridium-icons so they pick up the host theme — dark
// mode, focus rings, hover states, the lot — without us re-implementing any
// of it. They call the page component, whose queue sends their requests.
templ Toolbar(d *PageData) {
    <div class="lm-toolbar">
        @Selectors(d)
        <div class="lm-controls">
            <div x-show="editMode" x-cloak class="lm-controls">
                // The page settings sit with the page actions; with no page
                // buttons, here.
                if d.Settings && !hasSelectors(d) {
                    @SettingsToggle("ir-btn-icon-outline")
                }
                if len(d.AddOptions) > 0 {
                    // Opens the block gallery (see Gallery).
                    <button
                        type="button"
                        class="ir-btn-primary lm-icon-btn lm-gallery-toggle"
                        data-lm-gallery-toggle
                        :class="galleryToggleClass()"
                        aria-controls="lm-gallery"
                        :aria-expanded="galleryOpen"
                        @click="toggleGallery"
                    >
                        @icons.Plus.Component()
                        <span>Add block</span>
                    </button>
                }
                <button type="button" class="ir-btn-outline lm-icon-btn" @click="reset">
                    @icons.RotateCcw.Component()
                    <span>Reset</span>
                </button>
                if d.ShowLockButton {
                    <button type="button" class="ir-btn-outline lm-icon-btn" @click="cancel">
                        @icons.X.Component()
                        <span>Cancel</span>
                    </button>
                }
                <button type="button" class="ir-btn-primary lm-icon-btn" data-lm-done @click="save">
                    @icons.Check.Component()
                    <span>Done</span>
                </button>
            </div>
            if d.ShowLockButton {
                <button type="button" class="ir-btn-outline lm-icon-btn" x-show="!editMode" @click="startEditing">
                    @icons.Lock.Component()
                    <span>Edit</span>
                </button>
            }
            if d.ZenEnabled {
                <button type="button" class="ir-btn-outline lm-icon-btn" @click="enterZen">
                    @icons.Focus.Component()
                    <span>Zen</span>
                </button>
            }
        </div>
    </div>
}

// Selectors renders the page (layout) selector: one button per page, showing
// its name, or its number when it has none. Behaviour mirrors the Filament
// original:
//
//   - The whole strip is hidden unless we're editing OR more than one layout
//     holds content.
//   - In edit mode every page's button shows so the user can populate empty
//     pages; in view mode only the buttons for pages that actually have content
//     appear.
//   - The active page is highlighted (ir-btn-primary), the rest are ir-btn-outline.
//   - Clicking (or pressing 1..9) calls selectLayout(i), which swaps the grid
//     and updates the highlight.
//
// The pages, their names and which hold content come from the grid shown
// (data-lm-names, data-lm-populated), so the strip follows pages and blocks
// as they are added, removed and renamed. In edit mode the strip ends with
// the page actions: rename the page shown (a double-click on a page does the
// same), and, when the user decides how many pages there are, remove it or
// add one; then its settings.
templ Selectors(d *PageData) {
    if hasSelectors(d) {
        <div id="lm-selectors" class="lm-selectors" x-show="selectorsShown()" x-cloak>
            <template x-for="(name, i) in pages" :key="i">
                <span class="lm-page-tab" x-show="pageShown(i)">
                    <button
                        type="button"
                        class="lm-layout-btn"
                        :class="pageClass(i)"
                        :data-lm-layout="i"
                        x-show="!isRenaming(i)"
                        @click="selectLayout(i)"
                        if d.RenamablePages {
                            @dblclick="startRename(i)"
                        }
                    >
                        <span class="lm-layout-label" x-text="pageLabel(i)"></span>
                    </button>
                    if d.RenamablePages {
                        // Shown by a class, not x-show: x-show shows an
                        // element a frame later, too late to focus it.
                        <input
                            type="text"
                            class="lm-page-name"
                            maxlength={ strconv.Itoa(PageNameLength) }
                            aria-label="Page name"
                            :class="renameFieldClass(i)"
                            x-model="renameValue"
                            :placeholder="pageNumber(i)"
                            @keydown.enter.prevent="commitRename"
                            @keydown.escape.prevent="cancelRename"
                            @blur="commitRename"
                        />
                    }
                </span>
            </template>
            if d.RenamablePages {
                <button type="button" class="ir-btn-outline lm-page-action" x-show="editMode" aria-label="Rename page" title="Rename page" @click="startRename(currentLayout)">
                    @icons.Pencil.Component()
                </button>
            }
            if d.AddablePages {
                <button type="button" class="ir-btn-outline lm-page-action" x-show="canRemovePage()" aria-label="Remove page" title="Remove page" @click="removePage">
                    @icons.Trash.Component()
                </button>
                <button type="button" class="ir-btn-outline lm-page-action" x-show="editMode" aria-label="Add page" title="Add page" @click="addPage">
                    @icons.Plus.Component()
                </button>
            }
            if d.Settings {
                @SettingsToggle("ir-btn-outline lm-page-action")
            }
        </div>
    }
}

// hasSelectors reports whether the toolbar has page buttons: with more than
// one page, or pages the user adds.
func hasSelectors(d *PageData) bool {
    return d.AddablePages || d.LayoutCount > 1
}

// SettingsToggle opens the page settings (see SettingsDialog), in edit mode.
templ SettingsToggle(class string) {
    <button
        type="button"
        class={ class }
        data-lm-settings-toggle
        x-show="editMode"
        aria-haspopup="dialog"
        aria-label="Page settings"
        title="Page settings"
        @click="openSettings"
    >
        @icons.Settings.Component()
    </button>
}
